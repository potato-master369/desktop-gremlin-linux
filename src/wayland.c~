  case 153:
    request_frame(app_adata.current + app_adata.semote2);
    gtk_image_set_from_paintable(image, g_ptr_array_index(app_cdata.textures, app_adata.current + app_adata.semote1));
    if (app_adata.current == app_adata.eemote2 - app_adata.semote2) {
