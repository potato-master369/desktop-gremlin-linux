#!/bin/sh
# desktop-gremlin-linux PM recipe for Kritzkingvoid gremlins

if command -v curl >/dev/null 2>&1; then
    echo " -> curl is available"
else
    echo " !!! curl is not available"
    exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
    echo " -> sha256sum is available"
else
    echo " !!! sha256sum is not available"
    exit 1
fi

if command -v unzip >/dev/null 2>&1; then
    echo " -> unzip is available"
else
    echo " !!! unzip is not available"
    exit 1
fi

TEMP_ZIP=$(mktemp /tmp/dlpm-unverified-StayGold.XXXXXX.zip)
TEMP_DIR=$(mktemp -d /tmp/dlpm-StayGold-work.XXXXXX)

echo " -> Downloading asset..."
curl -L -o "$TEMP_ZIP" "https://github.com/Kritzkingvoid/Desktop_Gremlin/releases/download/v4.1/TracenAcademy_v4.1.zip"

if echo "e2377c0f8b9a152bc3ee3335be899543a2945e52ae40e9901facf3538f288fa1  $TEMP_ZIP" | sha256sum -c --status; then
    echo " -> Checksum pass"
else
    echo " !!! Checksum fail; this cannot be skipped as this is fetched from an archive URL."
    rm -f "$TEMP_ZIP"
    rm -rf "$TEMP_DIR"
    exit 1
fi

echo " -> Unzipping..."
unzip -q "$TEMP_ZIP" -d "$TEMP_DIR"

mkdir -p /usr/share/desktop-gremlin-linux/Sounds/StayGold
mkdir -p /usr/share/desktop-gremlin-linux/SpriteSheet/Gremlins/StayGold

echo " -> Installing files..."
cp -R "$TEMP_DIR/TracenAcademy_v4.1/Sounds/StayGold/." /usr/share/desktop-gremlin-linux/Sounds/StayGold/
cp -R "$TEMP_DIR/TracenAcademy_v4.1/SpriteSheet/Gremlins/StayGold/." /usr/share/desktop-gremlin-linux/SpriteSheet/Gremlins/StayGold/

echo " -> Cleaning up..."
rm -f "$TEMP_ZIP"
rm -rf "$TEMP_DIR"

echo " [ * ] Install finish!"
exit 0
